{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "communicator",
  "account_id": "b7cc0719d9ecb3485646785035f87ca1", // the same account as HelloChat and Pixel Plaza
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // The built app (npm run build). Only /api/* runs the Worker.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // The teacher's board (edited at /create), one copy for everyone.
  "durable_objects": {
    "bindings": [{ "name": "BOARD", "class_name": "BoardStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BoardStore"] }],

  // Budgets for OpenAI calls per visitor and for teacher-password guesses. Their own namespaces
  // (PinPlay 1001, Dictation Time 2001, Pixel Plaza 3001, HelloChat 4001).
  "ratelimits": [
    { "name": "AI_RL", "namespace_id": "5001", "simple": { "limit": 40, "period": 60 } },
    { "name": "AUTH_RL", "namespace_id": "5002", "simple": { "limit": 50, "period": 60 } }
  ]
}
