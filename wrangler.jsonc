{
  "$schema": "node_modules/wrangler/config-schema.json",
  // classroom.bat uses the default environment. Only deploy the online environment.
  "name": "communicator",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // The built app (npm run build). Only /api/* runs the Worker.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // The teacher's board (edited at /create) and the Fix switch, one copy for everyone.
  "durable_objects": {
    "bindings": [{ "name": "BOARD", "class_name": "BoardStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BoardStore"] }],

  // Budgets per student device (Fix and voices, 40 a minute each) and for teacher-password guesses.
  "ratelimits": [
    { "name": "USE_RL", "namespace_id": "5001", "simple": { "limit": 40, "period": 60 } },
    { "name": "AUTH_RL", "namespace_id": "5002", "simple": { "limit": 50, "period": 60 } }
  ],
  "env": {
    "online": {
      "name": "communicator-online",
      "account_id": "b7cc0719d9ecb3485646785035f87ca1",
      "workers_dev": true,
      "preview_urls": false,
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/create", "/create/"]
      },
      "vars": {
        "BOARD_REPOSITORY": "audiophrases/Communicator",
        // Online Fix asks OpenAI's gpt-4o-mini directly: free within the account's 2.5 million daily data-sharing tokens
        // (OPENAI-FREE-TOKENS.md), so the 24/7 board cannot run up gpt-6-luna bills. The laptop keeps gpt-6-luna.
        // xKiro was tried in November 2026: Mistral was dropped (404), paid models are refused to this key (403), and
        // the free Qwen models took 3–10 s, half past the 8 s timeout. Setting XKIRO_MODEL (with XKIRO_API_KEY) and
        // OPENAI_FALLBACK_MODEL brings xKiro back as the first choice.
        "OPENAI_PHRASE_MODEL": "gpt-4o-mini",
        // Online Fix answers in English only: gpt-4o-mini's Catalan was wrong about one sentence in four. The laptop
        // still translates.
        "FIX_TRANSLATION": "off"
      },
      "observability": { "enabled": true, "traces": { "enabled": true, "head_sampling_rate": 0.01 } },
      "durable_objects": {
        "bindings": [{ "name": "BOARD", "class_name": "BoardStore" }]
      },
      "ratelimits": [
        { "name": "USE_RL", "namespace_id": "5011", "simple": { "limit": 40, "period": 60 } },
        { "name": "AUTH_RL", "namespace_id": "5012", "simple": { "limit": 50, "period": 60 } }
      ]
    }
  }
}
