# classroom.bat makes .dev.vars the first time, copying from HelloChat or Pixel Plaza when it can.
# Never commit .dev.vars.

# The teacher's password for /create: the same CREATE_PASSWORD_HASH as PinPlay, HelloChat and Pixel Plaza.
# node -e "console.log(require('crypto').createHash('sha256').update(process.argv[1].trim().normalize('NFC')).digest('hex'))" "your password"
CREATE_PASSWORD_HASH=
# Fix (students' sentences) and the editor's Catalan translation. Leave empty to run without them.
# The teacher can also switch Fix off for students in /create.
OPENAI_API_KEY=
# Optional: the chat model for Fix and translation (default gpt-6-luna; see worker/model.ts). gpt-4o-mini was used before.
# OPENAI_PHRASE_MODEL=
# Optional: override PinPlay's Render Edge TTS bridge for the voices.
# EDGE_TTS_URL=https://pinplay-tts-bridge-27sk.onrender.com/tts
# EDGE_TTS_SECRET=
